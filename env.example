# Copie este archivo a .env.local y ajuste los valores SOLO en su máquina.
# EXPO_PUBLIC_* se incrusta en la app: NUNCA ponga aquí claves ni secretos.

# URL de medidor-api (en el emulador Android, 10.0.2.2 apunta a su PC)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Desfase de calibración del micrófono en dB (dBFS -> dB aproximado)
EXPO_PUBLIC_CALIBRACION_DB=90
