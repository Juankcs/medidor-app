{
  "name": "medidor-app",
  "version": "1.0.0",
  "description": "App Expo del Medidor de ruido del campus: mide dB sin guardar audio",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage",
    "test:hooks": "node --test .claude/hooks/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:hooks",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
